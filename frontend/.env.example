# For `npm run dev` (Vite dev server): the client calls this app under
# /api by default; the dev server proxies /api to the backend named here.
VITE_API_PROXY_TARGET=http://localhost:8000

# Override only if you want the built app to call a different API origin
# than same-origin "/api" (the default, and what the Docker/nginx setup
# reverse-proxies for you).
# VITE_API_BASE_URL=http://localhost:8000
